{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
      openai_api_base: { type: "string", secret: false },
      openai_model: { type: "string", secret: false },
    },
    required: ["openai_api_key"],
    additionalProperties: false,
  },

  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  program: {
    image: "ghcr.io/paulrychkov/agent-beats-tau2:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9010",

    env: {
      OPENAI_API_KEY: "${config.openai_api_key}",
      OPENAI_API_BASE: "${config.openai_api_base}",
      OPENAI_MODEL: "${config.openai_model}",
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9010 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },
}
